generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model About {
  id             String           @id
  description    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Certification  Certification[]
  Education      Education[]
  WorkExperience WorkExperience[]
}

model AdditionalTech {
  id           String   @id
  technologies String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model Certification {
  id      String  @id
  name    String
  issuer  String
  link    String?
  image   String?
  aboutId String
  About   About   @relation(fields: [aboutId], references: [id], onDelete: Cascade)
}

model Contact {
  id         String       @id
  email      String       @default("zenlalhamoud@gmail.com")
  phone      String       @default("+971 (504) 235-113")
  location   String?      @default("Abu Dhabi, UAE")
  whatsapp   String?      @default("971504235113")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  SocialLink SocialLink[]
}

model Education {
  id          String  @id
  degree      String
  institution String
  duration    String
  description String?
  order       Int     @default(0)
  aboutId     String
  About       About   @relation(fields: [aboutId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Personal {
  id               String   @id
  name             String   @default("Zain L. Alhamoud")
  title            String   @default("UI/UX Designer & Web Developer")
  bio              String   @default("A passionate 27-year-old designer and developer from Syria")
  description      String?  @default("specializing in creating beautiful, functional digital experiences that solve real-world problems and delight users.")
  profileImage     String   @default("/assets/zain.svg")
  resumeFile       String   @default("")
  typewriterTexts  String[]
  statProjects     String   @default("15+")
  statExperience   String   @default("3+")
  statSatisfaction String   @default("100%")
  createdAt        DateTime @default(now())
  updatedAt        DateTime
}

model Project {
  id           String   @id
  name         String
  description  String
  category     String
  image        String
  projectLink  String
  githubLink   String   @default("")
  technologies String[]
  featured     Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model Settings {
  id                  String   @id
  themePrimaryColor   String   @default("#0066FF")
  themeSecondaryColor String   @default("#8B5CF6")
  themeAccentColor    String   @default("#06D6A0")
  seoTitle            String   @default("Zain L. Alhamoud - UI/UX Designer & Web Developer")
  seoDescription      String   @default("Professional portfolio showcasing modern web development and design projects")
  seoKeywords         String   @default("UI/UX Designer, Web Developer, React, JavaScript, Portfolio")
  seoOgImage          String   @default("")
  googleAnalyticsId   String   @default("")
  maintenanceMode     Boolean  @default(false)
  customCSS           String   @default("")
  customJS            String   @default("")
  footerText          String   @default("© 2025 Zain L. Alhamoud. All rights reserved.")
  createdAt           DateTime @default(now())
  updatedAt           DateTime
}

model Skill {
  id         String   @id
  name       String
  percentage Int
  icon       String
  category   String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model SkillCategory {
  id        String   @id
  name      String   @unique
  icon      String   @default("fas fa-code")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model SocialLink {
  id        String  @id
  platform  String
  url       String
  icon      String
  contactId String
  Contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("admin")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Visitor {
  id        String   @id
  ipAddress String
  userAgent String
  timestamp DateTime @default(now())
  browser   String?
  os        String?
  device    String?
  referrer  String?
  country   String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([ipAddress])
  @@index([ipAddress, timestamp])
  @@index([timestamp])
}

model WorkExperience {
  id               String   @id
  title            String
  company          String
  duration         String
  location         String
  responsibilities String[]
  order            Int      @default(0)
  aboutId          String
  About            About    @relation(fields: [aboutId], references: [id], onDelete: Cascade)
}

model Media {
  id        String   @id @default(uuid())
  url       String
  publicId  String   @unique
  folder    String?  @default("portfolio")
  createdAt DateTime @default(now())
}
